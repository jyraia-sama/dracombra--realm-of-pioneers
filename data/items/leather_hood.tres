[ext_resource type="Texture2D" path="res://assets/sprites/items/items.png" id="2_icons"]

[sub_resource type="AtlasTexture" id="AtlasTexture_icon"]
atlas = ExtResource("2_icons")
region = Rect2(640, 0, 32, 32)

[resource]
