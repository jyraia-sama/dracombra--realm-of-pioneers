[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://scripts/data/item_data.gd" id="1_item"]
[ext_resource type="Texture2D" path="res://assets/sprites/items/items_mx.png" id="2_icons"]

[sub_resource type="AtlasTexture" id="AtlasTexture_icon"]
atlas = ExtResource("2_icons")
region = Rect2(64, 0, 32, 32)

[resource]
script = ExtResource("1_item")
id = &"sacred_shield"
display_name = "Bouclier sacré"
icon = SubResource("AtlasTexture_icon")
description = "Le bouclier béni des pionniers. Sa lumière protège ceux qui combattent près du paladin."
category = &"equipment"
slot = &"off"
bonus = {&"def": 6, &"parry": 12, &"wis": 3}
classes = Array[StringName]([&"paladin"])
