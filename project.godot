; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dracombra : Realm of Pioneers"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*uid://f57mwd80yu0t"
Inventory="*res://scripts/autoload/inventory.gd"
Hero="*res://scripts/autoload/hero.gd"
Town="*res://scripts/autoload/town.gd"
Save="*res://scripts/autoload/save.gd"
Interaction="*res://scripts/autoload/interaction.gd"
Narration="*res://scenes/ui/narration.tscn"
Transition="*res://scenes/ui/transition.tscn"
Choice="*res://scripts/autoload/choice.gd"
Crafting="*res://scripts/autoload/crafting.gd"
Quests="*res://scripts/autoload/quests.gd"
GameMenu="*res://scenes/ui/game_menu.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/scale_mode="fractional"

